<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.0" name="LobbyUI" editor-extension-namespaces="UnityEditor.UIElements" editor-extension-style-sheets="UnityEditor.UIElements/Controls.uss" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; justify-content: center; align-items: center; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
        <ui:Button name="startGameButton" text="Singleplayer" style="width: 250px; height: 50px; font-size: 24px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(77, 77, 77); border-right-color: rgb(77, 77, 77); border-top-color: rgb(77, 77, 77); border-bottom-color: rgb(77, 77, 77); background-color: rgb(102, 102, 102);"/>
        <ui:VisualElement style="height: 30px;"/>
        <ui:Label text="Multiplayer" style="font-size: 20px; -unity-font-style: bold; margin-bottom: 5px;"/>
        <ui:Button name="multiplayerHostButton" text="Host Game" style="width: 250px; height: 50px; font-size: 24px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(77, 77, 77); border-right-color: rgb(77, 77, 77); border-top-color: rgb(77, 77, 77); border-bottom-color: rgb(77, 77, 77); background-color: rgb(102, 102, 102);"/>
        <ui:VisualElement style="flex-direction: row; align-items: center; margin-top: 10px;">
            <ui:TextField name="ipAddressField" value="localhost" style="width: 160px; height: 40px; font-size: 16px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgb(255, 0, 0); -unity-background-image-tint-color: rgb(128, 128, 128); display: flex; visibility: visible; overflow: hidden;"/>
            <ui:Button name="multiplayerJoinButton" text="Join" style="width: 80px; height: 40px; font-size: 20px; margin-left: 5px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(77, 77, 77); border-right-color: rgb(77, 77, 77); border-top-color: rgb(77, 77, 77); border-bottom-color: rgb(77, 77, 77); background-color: rgb(102, 102, 102);"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement style="position: absolute; right: 10px; top: 10px;">
        <ui:Button name="exitGameButton" text="Exit" style="width: 80px; height: 30px; font-size: 16px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(56, 56, 56); border-right-color: rgb(56, 56, 56); border-top-color: rgb(56, 56, 56); border-bottom-color: rgb(56, 56, 56); background-color: rgb(102, 102, 102);"/>
    </ui:VisualElement>
</ui:UXML>
